# ---------- Server ----------
PORT=4000
NODE_ENV=development
# long random string (min 32 chars) — REQUIRED in production
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Postgres connection string (free: neon.tech or supabase.com). Without it dev mode uses a temporary in-memory DB.
DATABASE_URL=

# First-run admin account (created only when the users table is empty)
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=ChangeMe123

# Public URL of the deployed app (used in email links + CORS), e.g. https://rapidresq.onrender.com
CLIENT_URL=

# Real email (SMTP). Gmail: host smtp.gmail.com, port 587, user = your gmail, pass = 16-char App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RapidResQ <you@gmail.com>

# Free hosting email fallback (Render Free blocks outbound SMTP)
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# ---------- Frontend (build time; only needed for the Android app or a separately hosted frontend) ----------
# VITE_API_URL=https://rapidresq.onrender.com
